# Token from @BotFather (/newbot). Required.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Your numeric Telegram user id, from @userinfobot. Required.
# Every update from any other user is dropped before it reaches a handler.
ALLOWED_USER_ID=123456789

# SQLite file. Optional, defaults to expenses.db relative to the working directory.
# On the server the systemd unit sets WorkingDirectory=/var/lib/expense-bot.
DB_PATH=expenses.db
